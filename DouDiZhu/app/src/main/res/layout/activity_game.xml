<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_table">

    <!-- ===== 叫牌面板 ===== -->
    <LinearLayout
        android:id="@+id/bidPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="叫 牌"
            android:textSize="28sp"
            android:textColor="#F9A825"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvBidTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="轮到你叫牌"
            android:textSize="16sp"
            android:textColor="#CCFFFFFF"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvBidStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="#AAFFFFFF"
            android:layout_marginBottom="12dp"/>

        <com.ddz.game.ui.CardGroupView
            android:id="@+id/bottomCardsAreaBid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <com.ddz.game.ui.PlayerHandView
            android:id="@+id/playerHandBid"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/btnBid0"
                android:layout_width="80dp" android:layout_height="48dp"
                android:text="不叫" android:textColor="#FFFFFF" android:textStyle="bold"
                android:background="@drawable/btn_pass_bg" android:layout_marginEnd="10dp"/>
            <Button android:id="@+id/btnBid1"
                android:layout_width="80dp" android:layout_height="48dp"
                android:text="1分" android:textColor="#FFFFFF" android:textStyle="bold"
                android:background="@drawable/btn_bid_bg" android:layout_marginEnd="10dp"/>
            <Button android:id="@+id/btnBid2"
                android:layout_width="80dp" android:layout_height="48dp"
                android:text="2分" android:textColor="#FFFFFF" android:textStyle="bold"
                android:background="@drawable/btn_bid_bg" android:layout_marginEnd="10dp"/>
            <Button android:id="@+id/btnBid3"
                android:layout_width="80dp" android:layout_height="48dp"
                android:text="3分" android:textColor="#FFFFFF" android:textStyle="bold"
                android:background="@drawable/btn_play_bg"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== 游戏面板 ===== -->
    <LinearLayout
        android:id="@+id/gamePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 上方：左AI + 中间信息 + 右AI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- 左AI -->
            <LinearLayout
                android:layout_width="110dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="6dp"
                android:background="#33000000">
                <TextView android:id="@+id/tvLeftAiName"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="[农] 左家" android:textColor="#FFFFFF" android:textStyle="bold"
                    android:textSize="13sp"/>
                <TextView android:id="@+id/tvLeftAiCount"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="17张" android:textColor="#AAFFFFFF" android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>
                <com.ddz.game.ui.CardGroupView android:id="@+id/leftAiCards"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- 中间区域 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- 底牌 + 地主信息 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp">
                    <TextView android:id="@+id/tvLandlordBadge"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="地主:-" android:textColor="#F9A825" android:textStyle="bold"
                        android:textSize="12sp" android:layout_marginEnd="10dp"/>
                    <TextView android:id="@+id/tvMultiplier"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="x1" android:textColor="#FF5722" android:textStyle="bold"
                        android:textSize="16sp"/>
                </LinearLayout>

                <com.ddz.game.ui.CardGroupView android:id="@+id/bottomCardsArea"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"/>

                <!-- 桌面出牌区 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <com.ddz.game.ui.CardGroupView android:id="@+id/tableCardsLeft"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="4dp"/>

                    <com.ddz.game.ui.CardGroupView android:id="@+id/tableCardsCenter"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_centerInParent="true"/>

                    <com.ddz.game.ui.CardGroupView android:id="@+id/tableCardsRight"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="4dp"/>

                    <TextView android:id="@+id/tvTurnHint"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="" android:textColor="#CCFFFFFF" android:textSize="11sp"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:layout_marginBottom="2dp"/>
                </RelativeLayout>
            </LinearLayout>

            <!-- 右AI -->
            <LinearLayout
                android:layout_width="110dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="6dp"
                android:background="#33000000">
                <TextView android:id="@+id/tvRightAiName"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="[农] 右家" android:textColor="#FFFFFF" android:textStyle="bold"
                    android:textSize="13sp"/>
                <TextView android:id="@+id/tvRightAiCount"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="17张" android:textColor="#AAFFFFFF" android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>
                <com.ddz.game.ui.CardGroupView android:id="@+id/rightAiCards"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 下方：玩家区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#55000000">

            <!-- 玩家信息行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp">
                <TextView android:id="@+id/tvPlayerName"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="[?] 你" android:textColor="#FFFFFF" android:textStyle="bold"
                    android:textSize="13sp"/>
                <TextView android:id="@+id/tvPlayerCount"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="17张" android:textColor="#AAFFFFFF" android:textSize="12sp"
                    android:layout_marginEnd="16dp"/>
                <TextView android:id="@+id/tvScores"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="你:0  左:0  右:0"
                    android:textColor="#F9A825" android:textSize="12sp"/>
            </LinearLayout>

            <!-- 手牌 -->
            <com.ddz.game.ui.PlayerHandView
                android:id="@+id/playerHand"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>

            <!-- 按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="8dp">

                <Button android:id="@+id/btnSort"
                    android:layout_width="80dp" android:layout_height="44dp"
                    android:text="整理" android:textColor="#FFFFFF" android:textStyle="bold"
                    android:background="@drawable/btn_pass_bg"
                    android:layout_marginEnd="12dp"/>

                <Button android:id="@+id/btnPass"
                    android:layout_width="100dp" android:layout_height="44dp"
                    android:text="不  出" android:textSize="16sp"
                    android:textColor="#FFFFFF" android:textStyle="bold"
                    android:background="@drawable/btn_pass_bg"
                    android:enabled="false"
                    android:layout_marginEnd="12dp"/>

                <Button android:id="@+id/btnPlay"
                    android:layout_width="120dp" android:layout_height="44dp"
                    android:text="出  牌" android:textSize="16sp"
                    android:textColor="#FFFFFF" android:textStyle="bold"
                    android:background="@drawable/btn_play_bg"
                    android:enabled="false"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
