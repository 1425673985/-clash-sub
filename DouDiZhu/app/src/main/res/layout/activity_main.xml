<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_table">

    <!-- 音效切换 - 右上角 -->
    <Button
        android:id="@+id/btnSoundToggleMain"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="10dp"
        android:text="♪ 音效"
        android:textSize="13sp"
        android:textColor="#CCFFFFFF"
        android:background="@drawable/bg_sound_btn"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"/>

    <!-- 中心布局 -->
    <LinearLayout
        android:id="@+id/centerLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="斗 地 主"
            android:textSize="52sp"
            android:textStyle="bold"
            android:textColor="#F9A825"
            android:shadowColor="#000000"
            android:shadowDx="3"
            android:shadowDy="3"
            android:shadowRadius="8"
            android:layout_marginBottom="6dp"/>

        <!-- 副标题分隔线 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">
            <View
                android:layout_width="50dp"
                android:layout_height="1dp"
                android:background="#55F9A825"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  选择难度开始游戏  "
                android:textSize="13sp"
                android:textColor="#CCFFFFFF"/>
            <View
                android:layout_width="50dp"
                android:layout_height="1dp"
                android:background="#55F9A825"/>
        </LinearLayout>

        <!-- 新手行 -->
        <LinearLayout
            android:id="@+id/rowBeginner"
            android:layout_width="280dp"
            android:layout_height="58dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_difficulty_row"
            android:paddingLeft="20dp"
            android:paddingRight="16dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="新  手"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvBeginnerStat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="暂无记录"
                android:textSize="11sp"
                android:textColor="#AAFFFFFF"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvBeginnerRate"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text=""
            android:textSize="10sp"
            android:textColor="#88FFD740"
            android:layout_marginBottom="10dp"
            android:paddingRight="4dp"/>

        <!-- 普通行 -->
        <LinearLayout
            android:id="@+id/rowNormal"
            android:layout_width="280dp"
            android:layout_height="58dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_difficulty_row"
            android:paddingLeft="20dp"
            android:paddingRight="16dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="普  通"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvNormalStat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="暂无记录"
                android:textSize="11sp"
                android:textColor="#AAFFFFFF"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvNormalRate"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text=""
            android:textSize="10sp"
            android:textColor="#88FFD740"
            android:layout_marginBottom="10dp"
            android:paddingRight="4dp"/>

        <!-- 高级行 -->
        <LinearLayout
            android:id="@+id/rowExpert"
            android:layout_width="280dp"
            android:layout_height="58dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_expert_row"
            android:paddingLeft="20dp"
            android:paddingRight="16dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="高  级"
                android:textSize="22sp"
                android:textColor="#FFD740"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvExpertStat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="暂无记录"
                android:textSize="11sp"
                android:textColor="#CCFFFFFF"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvExpertRate"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text=""
            android:textSize="10sp"
            android:textColor="#88FFD740"
            android:layout_marginBottom="0dp"
            android:paddingRight="4dp"/>

    </LinearLayout>

    <!-- 版本号左下 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="8dp"
        android:text="斗地主 v2.0"
        android:textColor="#44FFFFFF"
        android:textSize="10sp"/>

</RelativeLayout>
