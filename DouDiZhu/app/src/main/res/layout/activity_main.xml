<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_table">

    <!-- 标题 -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="斗 地 主"
        android:textSize="52sp"
        android:textStyle="bold"
        android:textColor="#F9A825"
        android:shadowColor="#000000"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVerticalChainStyle="packed"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="选择难度开始游戏"
        android:textSize="18sp"
        android:textColor="#CCFFFFFF"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintBottom_toTopOf="@id/btnBeginner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="32dp"/>

    <!-- 新手按钮 -->
    <Button
        android:id="@+id/btnBeginner"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:text="🌱 新  手"
        android:textSize="22sp"
        android:textColor="@color/text_white"
        android:textStyle="bold"
        android:background="@drawable/btn_difficulty_bg"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintBottom_toTopOf="@id/btnNormal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp"/>

    <!-- 普通按钮 -->
    <Button
        android:id="@+id/btnNormal"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:text="⚔️ 普  通"
        android:textSize="22sp"
        android:textColor="@color/text_white"
        android:textStyle="bold"
        android:background="@drawable/btn_difficulty_bg"
        app:layout_constraintTop_toBottomOf="@id/btnBeginner"
        app:layout_constraintBottom_toTopOf="@id/btnExpert"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp"/>

    <!-- 高级按钮 -->
    <Button
        android:id="@+id/btnExpert"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:text="🔥 高  级"
        android:textSize="22sp"
        android:textColor="@color/text_white"
        android:textStyle="bold"
        android:background="@drawable/btn_difficulty_bg"
        app:layout_constraintTop_toBottomOf="@id/btnNormal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
