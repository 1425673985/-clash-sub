<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_table">

    <!-- Decorative card fan hint at top-right (pure visual) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="32dp" android:layout_height="48dp"
            android:text="A" android:textColor="#C62828" android:textStyle="bold"
            android:textSize="22sp" android:gravity="center"
            android:background="#FFFDE7" android:rotation="-8"/>
        <TextView
            android:layout_width="32dp" android:layout_height="48dp"
            android:text="K" android:textColor="#1A1A1A" android:textStyle="bold"
            android:textSize="22sp" android:gravity="center"
            android:background="#FFFDE7" android:rotation="-2"
            android:layout_marginStart="-10dp"/>
        <TextView
            android:layout_width="32dp" android:layout_height="48dp"
            android:text="大" android:textColor="#C62828" android:textStyle="bold"
            android:textSize="16sp" android:gravity="center"
            android:background="#FFFDE7" android:rotation="4"
            android:layout_marginStart="-10dp"/>
    </LinearLayout>

    <!-- Center layout -->
    <LinearLayout
        android:id="@+id/centerLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="斗 地 主"
            android:textSize="52sp"
            android:textStyle="bold"
            android:textColor="#F9A825"
            android:shadowColor="#000000"
            android:shadowDx="3"
            android:shadowDy="3"
            android:shadowRadius="8"
            android:layout_marginBottom="4dp"/>

        <!-- Subtitle decoration -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="28dp">
            <View
                android:layout_width="60dp"
                android:layout_height="1dp"
                android:background="#66F9A825"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  选择难度  "
                android:textSize="14sp"
                android:textColor="#CCFFFFFF"
                android:letterSpacing="0.1"/>
            <View
                android:layout_width="60dp"
                android:layout_height="1dp"
                android:background="#66F9A825"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnBeginner"
            android:layout_width="220dp"
            android:layout_height="56dp"
            android:text="新  手"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/btn_difficulty_bg"
            android:layout_marginBottom="14dp"/>

        <Button
            android:id="@+id/btnNormal"
            android:layout_width="220dp"
            android:layout_height="56dp"
            android:text="普  通"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/btn_difficulty_bg"
            android:layout_marginBottom="14dp"/>

        <Button
            android:id="@+id/btnExpert"
            android:layout_width="220dp"
            android:layout_height="56dp"
            android:text="高  级"
            android:textSize="22sp"
            android:textColor="#FFD740"
            android:textStyle="bold"
            android:background="@drawable/btn_play_bg"/>

    </LinearLayout>

    <!-- Version hint bottom left -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp"
        android:text="斗地主 v1.0"
        android:textColor="#66FFFFFF"
        android:textSize="10sp"/>

</RelativeLayout>
