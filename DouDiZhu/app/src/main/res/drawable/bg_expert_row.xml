<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:startColor="#E65100" android:endColor="#BF360C" android:angle="90"/>
            <corners android:radius="24dp"/>
            <stroke android:width="2dp" android:color="#FFD740"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:startColor="#FF8F00" android:endColor="#E65100" android:angle="90"/>
            <corners android:radius="24dp"/>
            <stroke android:width="1dp" android:color="#99FFD740"/>
        </shape>
    </item>
</selector>
