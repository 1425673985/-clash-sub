<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <gradient android:startColor="#616161" android:endColor="#424242" android:angle="90"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <gradient android:startColor="#E64A19" android:endColor="#BF360C" android:angle="90"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:startColor="#FF7043" android:endColor="#E64A19" android:angle="90"/>
            <corners android:radius="22dp"/>
            <stroke android:width="1dp" android:color="#FFCC02"/>
        </shape>
    </item>
</selector>
