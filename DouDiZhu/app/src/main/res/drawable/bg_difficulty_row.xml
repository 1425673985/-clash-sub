<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:startColor="#1B5E20" android:endColor="#0D3B14" android:angle="90"/>
            <corners android:radius="24dp"/>
            <stroke android:width="2dp" android:color="#69F0AE"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:startColor="#388E3C" android:endColor="#1B5E20" android:angle="90"/>
            <corners android:radius="24dp"/>
            <stroke android:width="1dp" android:color="#66A5D6A7"/>
        </shape>
    </item>
</selector>
