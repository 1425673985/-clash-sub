<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <gradient android:startColor="#757575" android:endColor="#616161" android:angle="90"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <gradient android:startColor="#1565C0" android:endColor="#0D47A1" android:angle="90"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:startColor="#42A5F5" android:endColor="#1E88E5" android:angle="90"/>
            <corners android:radius="22dp"/>
            <stroke android:width="1dp" android:color="#90CAF9"/>
        </shape>
    </item>
</selector>
