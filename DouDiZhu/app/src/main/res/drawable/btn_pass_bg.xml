<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <gradient android:startColor="#757575" android:endColor="#616161" android:angle="90"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <gradient android:startColor="#37474F" android:endColor="#263238" android:angle="90"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:startColor="#546E7A" android:endColor="#37474F" android:angle="90"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
</selector>
